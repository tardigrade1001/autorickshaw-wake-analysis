FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application     pimpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         3.0;
deltaT          0.0005;
writeControl    adjustableRunTime;
writeInterval   0.5;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           5;
maxDeltaT       0.01;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        patches         (vehicle);
        rho             rhoInf;
        rhoInf          1.225;
        liftDir         (0 0 1);
        dragDir         (1 0 0);
        CofR            (2.765 0 0.5);
        pitchAxis       (0 1 0);
        magUInf         16.67;
        lRef            2.765;
        Aref            2.162;
    }

    // Road-origin passive tracer. nut MUST be named or turbulent diffusion is
    // omitted entirely (default is "none") and the plume stays artificially tight.
    roadTracer
    {
        type            scalarTransport;
        libs            (solverFunctionObjects);
        enabled         true;
        field           s;
        nut             nut;
        alphaD          1;
        alphaDt         1.4286;   // 1/Sct, Sct = 0.7
        D               1.5e-05;
        bounded01       true;
        nCorr           1;
        resetOnStartUp  false;
        write           true;
        writeControl    writeTime;
    }

    // Single pedestrian standoff only, U and s only, every 8th step:
    // keeps the pulled data near 2 GB instead of >10 GB.
    pedPlanes
    {
        type            surfaces;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   8;
        fields          (U s);
        interpolationScheme cellPoint;
        surfaceFormat   raw;
        surfaces
        {
            y1p2 { type cuttingPlane; point (0 1.2 0); normal (0 1 0); interpolate true; }
        }
    }

    topPlanesLive
    {
        type            surfaces;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   16;
        fields          (s);
        interpolationScheme cellPoint;
        surfaceFormat   raw;
        surfaces
        {
            z0p60 { type cuttingPlane; point (0 0 0.60); normal (0 0 1); interpolate true; }
            z1p00 { type cuttingPlane; point (0 0 1.00); normal (0 0 1); interpolate true; }
        }
    }
}
